import "package://github.com/jdx/hk/releases/download/v2.7.0/hk@2.7.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.7.0/hk@2.7.0#/Builtins.pkl"

// Keep in lockstep with the amends/import version above — bump both together.
min_hk_version = "2.7.0"

/// Fails when a consuming repo's `hk.pkl` `amends` and `import` pins
/// disagree, or when a `mise.toml` `hk` pin differs from the `hk.pkl` one.
/// It deliberately doesn't compare against `min_hk_version`: hk itself
/// refuses to run when the binary is older than that, and an hk newer than
/// this hk-config release was built against is fine. Rides along in `base`,
/// so it needs no per-repo wiring.
local hkPinSync: Config.Step = new Config.Step {
    glob = List("hk.pkl", "mise.toml")
    // One line, ';'-separated, no backslash continuations: hk flattens the
    // command, so a continuation backslash reaches grep as a literal argument.
    check = "pins=$(grep -Eo 'jdx/hk/releases/download/v[^/]+/hk@[^#]+#' hk.pkl | sed -E 's/.*hk@//; s/#$//' | sort -u); { [ -n \"$pins\" ] && [ \"$(echo \"$pins\" | wc -l)\" -eq 1 ]; } || { echo 'hk.pkl must pin exactly one hk version across amends/import' >&2; exit 1; }; if grep -Eq '^hk *=' mise.toml 2>/dev/null; then grep -Eq \"^hk *= *\\\"$pins\\\"\" mise.toml || { echo \"mise.toml pins an hk version other than hk.pkl's $pins\" >&2; exit 1; }; fi"
}

/// The lowest-common-denominator step set shared by every hugoh repo's
/// `hk.pkl`: the same key/value pairs, active and unmodified, across all of
/// them. Repo-specific overrides (excludes, custom commands, etc.) are
/// applied locally after spreading this in, e.g.:
///
/// ```
/// import "package://github.com/hugoh/hk-config/releases/download/vA.B.C/hk-config@A.B.C#/base.pkl" as Base
///
/// local linters = new Mapping<String, Step> {
///     ...Base.base
///     ["trailing_whitespace"] = (Builtins.trailing_whitespace) {
///         exclude = List("some/generated/dir/**")
///     }
/// }
/// ```
base: Mapping<String, Config.Step> = new Mapping<String, Config.Step> {
    ["jactionlint"] = Builtins.jactionlint
    ["pinact"] = Builtins.pinact
    ["check_merge_conflict"] = Builtins.check_merge_conflict
    ["trailing_whitespace"] = Builtins.trailing_whitespace
    ["mixed_line_ending"] = Builtins.mixed_line_ending
    ["newlines"] = Builtins.newlines
    ["check_case_conflict"] = Builtins.check_case_conflict
    ["check_added_large_files"] = Builtins.check_added_large_files
    ["check_executables_have_shebangs"] = Builtins.check_executables_have_shebangs
    ["check_symlinks"] = Builtins.check_symlinks
    ["gitleaks"] = Builtins.gitleaks
    ["ghalint_workflow"] = Builtins.ghalint_workflow
    ["rumdl"] = Builtins.rumdl
    ["rumdl_format"] = Builtins.rumdl_format
    ["biome"] = Builtins.biome
    ["zizmor"] = Builtins.zizmor
    ["typos"] = Builtins.typos
    ["mise"] = Builtins.mise
    ["tombi"] = Builtins.tombi
    ["tombi_format"] = Builtins.tombi_format
    ["ryl"] = Builtins.ryl
    ["hk_pin_sync"] = hkPinSync
}

/// Python repos: ruff (lint + format) and ty (type checking). Spread this in
/// alongside `base`, then override individual keys locally for repo-specific
/// commands (e.g. running via `uv run` instead of a PATH binary).
python: Mapping<String, Config.Step> = new Mapping<String, Config.Step> {
    ["ruff"] = Builtins.ruff
    ["ruff_format"] = Builtins.ruff_format
    ["ty"] = Builtins.ty
}

/// Shell script repos: shellcheck, shellharden, shfmt. Deliberately doesn't
/// include ansible-lint (only relevant to the subset of shell repos running
/// Ansible) or secrets scanning (already in `base` via gitleaks).
shell: Mapping<String, Config.Step> = new Mapping<String, Config.Step> {
    ["shellcheck"] = Builtins.shellcheck
    ["shellharden"] = Builtins.shellharden
    ["shfmt"] = Builtins.shfmt
}

/// OpenTofu / Terraform repos: tflint, `tofu fmt`, a Trivy misconfiguration
/// scan (HIGH/CRITICAL), and `tofu validate`. Spread this in alongside
/// `base`; `tf_security` runs `trivy config` over the repo root rather than
/// per-file, so it re-runs whenever any `*.tf` file changes.
///
/// `tofu_validate` is gated to the `ci` profile: it needs `tofu init` (network,
/// provider downloads) so it's a poor fit for `pre-commit`, and it only
/// validates the root module in the working directory. The shared
/// `hugoh/gh-workflows/hk-check` action runs `hk check --profile ci`, so it
/// runs in CI automatically; run it locally with `hk check --profile ci`.
tf: Mapping<String, Config.Step> = new Mapping<String, Config.Step> {
    ["tf_lint"] = Builtins.tf_lint
    ["tofu"] = Builtins.tofu
    ["tf_security"] = new Config.Step {
        glob = List("**/*.tf")
        check = "trivy config --exit-code 1 --severity HIGH,CRITICAL ."
    }
    ["tofu_validate"] = new Config.Step {
        glob = List("**/*.tf")
        check = "tofu init -backend=false -input=false && tofu validate"
        profiles = List("ci")
    }
}

/// Deprecated: biome moved into `base` (it now also covers JSON, replacing
/// dprint). Kept as an empty group so repos still spreading `...Base.web`
/// don't break; drop that spread next time you touch those repos' `hk.pkl`.
web: Mapping<String, Config.Step> = new Mapping<String, Config.Step> {}

/// Lua repos (Hammerspoon Spoons, dotfiles): selene + stylua.
lua: Mapping<String, Config.Step> = new Mapping<String, Config.Step> {
    ["selene"] = Builtins.selene
    ["stylua"] = Builtins.stylua
}

/// Renovate config linting: validates `.renovaterc.json` with
/// `renovate-config-validator`. Only meaningful for repos that ship Renovate
/// config, so — unlike `base` — this isn't spread into every repo
/// automatically; opt in explicitly. Repos that also export their own preset
/// files (e.g. `default.json`, `presets/*.json`) override the `glob` on this
/// key after spreading it in, the same way `go-tools`' `hk.pkl` overrides
/// `shellcheck_dev_tasks`'s `match_any`:
///
/// ```
/// ["renovate_config_validator"] = (Base.renovate["renovate_config_validator"]) {
///     glob = List("default.json", ".renovaterc.json", "presets/*.json")
/// }
/// ```
renovate: Mapping<String, Config.Step> = new Mapping<String, Config.Step> {
    ["renovate_config_validator"] = new Config.Step {
        glob = List(".renovaterc.json")
        check = "renovate-config-validator --strict --no-global {{files}}"
    }
}

/// Checkly monitoring-as-code validation: `checkly deploy --preview` is the
/// closest thing to an offline `checkly validate` (there isn't one) — it
/// still needs network access and `CHECKLY_API_KEY`/`CHECKLY_ACCOUNT_ID`, so
/// like `renovate` this isn't spread into every repo automatically; opt in
/// explicitly, and only into hooks where that's acceptable (`pre-push`,
/// `check`, `fix` — never `pre-commit`, which shouldn't depend on network +
/// credentials being available):
///
/// ```
/// local linters = new Mapping<String, Step> { ...Base.base }
/// local pushChecks = new Mapping<String, Step> { ...linters ...Base.checkly }
/// hooks {
///     ["pre-commit"] { fix = true; stash = "git"; steps = linters }
///     ["pre-push"] { steps = pushChecks }
///     ["fix"] { fix = true; steps = linters }
///     ["check"] { steps = pushChecks }
/// }
/// ```
checkly: Mapping<String, Config.Step> = new Mapping<String, Config.Step> {
    ["checkly_preview"] = new Config.Step {
        glob = List("checkly.config.ts", "__checks__/**")
        check = "npx checkly deploy --preview"
    }
}

/// Flat list of every step key across all groups above. Consumed by
/// `scripts/check-readme-steps.sh` to verify the README documents each step —
/// when you add a group, append its `.keys` here too. Not for spreading into
/// hooks; use the individual groups for that.
allStepKeys: List<String> =
    base.keys.toList()
    + python.keys.toList()
    + shell.keys.toList()
    + lua.keys.toList()
    + tf.keys.toList()
    + renovate.keys.toList()
    + checkly.keys.toList()
    + commit_msg.keys.toList()

/// The mise tool key each step runs, exactly as consuming repos pin it in
/// `mise.toml` (`null` when the step runs hk itself, mise itself, or a tool
/// that isn't pinned). `hugoh/renovate-config`'s `check-package-rules.mjs`
/// reads this to make sure every pinned linter is classified in its Renovate
/// rules, and `scripts/check-step-tools.sh` fails if it drifts from
/// `allStepKeys`.
stepTools: Mapping<String, String?> = new Mapping<String, String?> {
    ["jactionlint"] = "jactionlint"
    ["pinact"] = "pinact"
    ["check_merge_conflict"] = null
    ["trailing_whitespace"] = null
    ["mixed_line_ending"] = null
    ["newlines"] = null
    ["check_case_conflict"] = null
    ["check_added_large_files"] = null
    ["check_executables_have_shebangs"] = null
    ["check_symlinks"] = null
    ["gitleaks"] = "gitleaks"
    ["ghalint_workflow"] = "ghalint"
    ["rumdl"] = "rumdl"
    ["rumdl_format"] = "rumdl"
    ["biome"] = "biome"
    ["zizmor"] = "zizmor"
    ["typos"] = "typos"
    ["mise"] = null
    ["tombi"] = "tombi"
    ["tombi_format"] = "tombi"
    ["ryl"] = "github:owenlamont/ryl"
    ["hk_pin_sync"] = null
    ["ruff"] = "ruff"
    ["ruff_format"] = "ruff"
    ["ty"] = "ty"
    ["shellcheck"] = "shellcheck"
    ["shellharden"] = "aqua:anordal/shellharden"
    ["shfmt"] = "shfmt"
    ["selene"] = "aqua:Kampfkarren/selene"
    ["stylua"] = "stylua"
    ["tf_lint"] = "tflint"
    ["tofu"] = "tofu"
    ["tf_security"] = "trivy"
    ["tofu_validate"] = "tofu"
    ["renovate_config_validator"] = "npm:renovate"
    ["checkly_preview"] = null
    ["check_conventional_commit"] = null
}

/// Conventional Commit message linting. Needs `commit_msg_file`, which only
/// exists in a `commit-msg` hook — spread this into that hook's own steps,
/// never into `linters` (used by check/pre-commit/pre-push/fix), or the step
/// fails with "Variable `commit_msg_file` is not defined".
commit_msg: Mapping<String, Config.Step> = new Mapping<String, Config.Step> {
    ["check_conventional_commit"] = Builtins.check_conventional_commit
}
